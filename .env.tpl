# Demo works without this file or credentials.
PORT=3104
# Optional existing vault; only the documented scoped Markdown layout is read.
# VAULT_PATH=/absolute/path/to/your/chosen/vault
# ALLOW_VAULT_WRITES=false

# Optional local chat-completions server. Literal loopback only, exact path.
# Install/start your model server yourself and choose a downloaded local model.
# PERSONAL_OS_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# PERSONAL_OS_LLM_MODEL=your-installed-model-id

# Cloud model providers are not enabled in this application.
# Use a downloaded local model and configure the local daemon for offline operation.

# Optional explicitly selected read-only model vaults; never auto-discovered.
# PERSON_SELF_MODEL_PATH=/absolute/path/to/your/chosen/self-model-vault
# AI_MODEL_PATH=/absolute/path/to/your/chosen/ai-model-vault
# Reviewed observations are written to the model vaults only when this is true.
# ALLOW_MODEL_VAULT_WRITES=false
